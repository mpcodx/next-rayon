# ══════════════════════════════════════════════════════════════════════
#  Email  —  used by the contact form AND the interview drive
#  One account sends everything. Nothing else is needed for sending.
# ══════════════════════════════════════════════════════════════════════
EMAIL_USER=rayonwebsolutions@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM_NAME=Rayon Web Solutions
NEXT_PUBLIC_CONTACT_EMAIL=rayonwebsolutions@gmail.com

# Optional. Where booking notifications land. Defaults to EMAIL_USER,
# so leave it out unless HR uses a different inbox than the sender.
# EMAIL_TO=hr@rayonweb.com


# ══════════════════════════════════════════════════════════════════════
#  Interview drive  —  admin dashboard login  (REQUIRED)
#
#  This is the sign-in for /interview-drive-admin. It is a USERNAME,
#  not a mailbox — no email is ever sent to or from it.
#  Generate the hash with:  node scripts/interview-drive-admin.mjs
# ══════════════════════════════════════════════════════════════════════
INTERVIEW_ADMIN_EMAIL=hr@rayonweb.com
INTERVIEW_ADMIN_PASSWORD_HASH=
INTERVIEW_ADMIN_NAME=Rayon Web Admin


# ══════════════════════════════════════════════════════════════════════
#  Interview drive  —  emails  (nothing to configure)
#
#  The server runs its own email worker every 60s, so confirmations,
#  retries and the 24h/1h reminders all send on their own. No cron job
#  and no secret are needed.
#
#  Optional, only if you want an EXTERNAL scheduler to be able to force
#  a drain of the queue. A signed-in admin can already do this from the
#  dashboard, so most setups leave it blank.
# INTERVIEW_CRON_SECRET=
#
#  Optional: how often the worker checks for due emails, in ms.
# INTERVIEW_EMAIL_TICK_MS=60000


# ══════════════════════════════════════════════════════════════════════
#  Interview drive  —  optional tuning (sensible defaults, omit these)
# ══════════════════════════════════════════════════════════════════════
# Where bookings and resumes are written. Defaults to ./data.
# In Docker this is set to /app/data by docker-compose.
# INTERVIEW_DRIVE_DATA_DIR=

# Campaign window, IST. Defaults to 14-18 September 2026.
# INTERVIEW_DRIVE_START_DATE=2026-09-14
# INTERVIEW_DRIVE_END_DATE=2026-09-18

# Hold bookings closed until this date. Default: open immediately.
# INTERVIEW_DRIVE_OPENS_AT=

# Bookings per IP per hour. Default 40 — a college NATs its whole
# campus behind one address, so keep this generous.
# INTERVIEW_BOOKING_RATE_LIMIT=40
